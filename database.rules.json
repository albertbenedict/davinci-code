{
  "rules": {
    "davinciRooms": {
      "$code": {
        ".read": true,
        ".write": true,
        "meta": {
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|ended)$/)"
          },
          "$other": {
            ".validate": true
          }
        },
        "$other": {
          ".validate": true
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
