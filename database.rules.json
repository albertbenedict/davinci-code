{
  "rules": {
    ".read": false,
    ".write": false,
    "davinciRooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4,8}$/)",
        "meta": {
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|ended)$/)"
          }
        }
      }
    }
  }
}
